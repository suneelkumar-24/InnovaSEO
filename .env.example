# ==========================================
# 100% FREE AI PROVIDERS FOR NICHE HUNTER
# ==========================================

# 1. Google Gemini (100% FREE Tier - Highly Recommended)
# Get your free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. Groq Cloud (100% FREE Ultra-Fast Llama 3.3 / Mixtral API)
# Get your free key: https://console.groq.com/keys
GROQ_API_KEY=

# 3. OpenRouter (Free Open-source & Hermes Models)
# Get your free key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# 4. Local AI / Ollama / LM Studio (100% Free & Offline)
# Run Ollama (https://ollama.com) or LM Studio (https://lmstudio.ai) on your machine
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=hermes3

# 5. Optional Paid Providers
ANTHROPIC_API_KEY=

# Default Provider: 'auto', 'gemini', 'groq', 'openrouter', 'ollama', 'claude'
DEFAULT_AI_PROVIDER=auto

